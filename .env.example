# ---------------------------------------------------------------------------
# Copy this file to ".env" for LOCAL testing only.
# In production (GitHub Actions) these values MUST come from GitHub Secrets.
# Never commit a real .env file with real values.
# ---------------------------------------------------------------------------

# ---- REQUIRED (secrets) ----
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenFromBotFatherReplaceMe

# Recipients do not need an environment variable: each person subscribes by
# sending /start to the bot and can unsubscribe with /stop.

# Optional one-time migration from the old fixed-recipient version. These ids
# are imported on the first run only; new installations should leave this unset.
# TELEGRAM_CHAT_ID=123456789,987654321

# Optional independent Fernet key for encrypting subscriber ids. If omitted,
# the key is safely derived from TELEGRAM_BOT_TOKEN. Setting an independent key
# lets you rotate the bot token later without asking everyone to re-subscribe.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# SUBSCRIBER_ENCRYPTION_KEY=

# ---- OPTIONAL OVERRIDES (safe defaults are already built into the code) ----

# CROUS campaign tool id fallback (used only if homepage auto-detection fails).
# CROUS_FALLBACK_TOOL_ID=41

# Ile-de-France bounding box (two opposite corners).
# CROUS_BBOX_WEST=1.4461
# CROUS_BBOX_SOUTH=48.1201
# CROUS_BBOX_EAST=3.5590
# CROUS_BBOX_NORTH=49.2412

# Search paging.
# CROUS_PAGE_SIZE=50
# CROUS_MAX_PAGES=40

# HTTP timeouts / retries (CROUS requests).
# HTTP_CONNECT_TIMEOUT=10
# HTTP_READ_TIMEOUT=30
# HTTP_MAX_RETRIES=4
# HTTP_BACKOFF_BASE=2.0

# Telegram retries.
# TELEGRAM_MAX_RETRIES=5
# TELEGRAM_BACKOFF_BASE=2.0
# TELEGRAM_SEND_WORKERS=8

# Monitoring behaviour.
# FAILURE_THRESHOLD=3
# HEARTBEAT_INTERVAL_HOURS=24
